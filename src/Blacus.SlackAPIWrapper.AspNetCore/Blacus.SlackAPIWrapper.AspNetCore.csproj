<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFramework>net8.0</TargetFramework>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace />
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>Blacus Slack API Wrapper AspNetCore</Title>
		<Version>8.1.1-beta</Version>
		<PackageId>Blacus.$(AssemblyName)</PackageId>
		<Authors>Blacus</Authors>
		<Product>Blacus.$(AssemblyName)</Product>
		<PackageOutputPath>$(OutputPath)</PackageOutputPath>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<RepositoryUrl>https://github.com/Blacus-Software/Blacus.SlackAPIWrapper</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

</Project>
