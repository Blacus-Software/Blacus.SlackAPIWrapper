<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net8.0;net9.0;net10.0</TargetFrameworks>
		<ImplicitUsings>disable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<RootNamespace />
		<GeneratePackageOnBuild>True</GeneratePackageOnBuild>
		<Title>Blacus Slack API Wrapper AspNetCore</Title>
		<Version>9.1.1-beta</Version>
		<PackageId>Blacus.$(AssemblyName)</PackageId>
		<Authors>Blacus</Authors>
		<Product>Blacus.$(AssemblyName)</Product>
		<PackageOutputPath>$(OutputPath)</PackageOutputPath> 
		<RepositoryUrl>https://github.com/Blacus-Software/Blacus.SlackAPIWrapper</RepositoryUrl>
		<RepositoryType>git</RepositoryType>
	</PropertyGroup>

	<ItemGroup>
		<ProjectReference Include="..\Blacus.SlackAPIWrapper\SlackAPIWrapper.csproj" />
		<PackageReference Include="Microsoft.AspNetCore.Http.Abstractions" Version="2.3.0" />
		<PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.1" />
		<PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.1" />
		<PackageReference Include="Microsoft.Extensions.Http" Version="10.0.1" />
		<PackageReference Include="System.Text.Json" Version="10.0.1" />
		<PackageReference Include="Microsoft.Extensions.Logging" Version="10.0.1" />
		<PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.1" />
	</ItemGroup>
 
</Project>
